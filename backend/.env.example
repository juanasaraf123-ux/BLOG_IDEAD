APP_NAME="Portal IDEAD"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://idead.example.edu.co
PORTAL_URL=https://idead.example.edu.co
ADMIN_URL=https://idead.example.edu.co/admin
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Bogota

# NUNCA true en producción: muestra datos de demostración en el portal público.
# Llave para seudonimizar personas (mín. 32 caracteres; generar con: openssl rand -hex 32)
IDEAD_PSEUDONYM_KEY=
IDEAD_DEMO_DATA=false

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Base de datos: MariaDB 10.11+/MySQL 8.4 accesible solo desde red interna.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=idead_portal
DB_USERNAME=idead_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=idead.example.edu.co

TRUSTED_PROXIES=127.0.0.1
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-responder@example.edu.co"
MAIL_FROM_NAME="Portal IDEAD"

BCRYPT_ROUNDS=12
